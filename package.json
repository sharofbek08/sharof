{
  "name": "satrlarim",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:api": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "start:api": "npm run start --workspace backend",
    "db:up": "docker compose -f backend/docker-compose.yml up -d db",
    "db:down": "docker compose -f backend/docker-compose.yml down"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
